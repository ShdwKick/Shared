#!/bin/sh
# Не даёт закоммитить сервис, у которого копии общих файлов разъехались с Shared/.
#
# Установка в репозиторий сервиса (выполнять из его корня):
#   cp ../Shared/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#
# Хуки не коммитятся вместе с кодом, поэтому ставить нужно в каждом репозитории
# и заново после свежего клона. Здесь файл лежит именно для того, чтобы его было
# откуда копировать, а не вспоминать содержимое.

SYNC=../Shared/sync.mjs

# Сервис могли склонировать отдельно, без соседней папки Shared. Блокировать
# коммиты в этом случае нельзя: человек мог прийти чинить баг и про стили вообще
# не знать.
if [ ! -f "$SYNC" ]; then
  echo "pre-commit: Shared/ рядом не найден — проверку общих файлов пропускаю"
  exit 0
fi

if ! node "$SYNC" --check; then
  echo ""
  echo "Копии общих файлов отстали от Shared/."
  echo "Разложите и добавьте в коммит:  node ../Shared/sync.mjs"
  echo "Закоммитить как есть (осознанно):  git commit --no-verify"
  exit 1
fi
